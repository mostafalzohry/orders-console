NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/orders_console
# At least 32 characters. Generate a real one with: openssl rand -base64 48
# Values starting with "change-me" are rejected when NODE_ENV=production.
JWT_SECRET=change-me-dev-only-change-me-dev-only-0000
# Login token (and cookie) lifetime in seconds. Default 3600 = 1 hour.
JWT_EXPIRES_IN_SECONDS=3600
# Max login attempts per minute for one email from one IP (brute force on an account).
LOGIN_RATE_LIMIT_PER_ACCOUNT=5
# Max login attempts per minute from one IP across all emails (password spraying).
LOGIN_RATE_LIMIT_PER_IP=30
